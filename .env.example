# 이 파일을 .env 로 복사해 값을 채우면 tools/dev-server.js 가 읽어 갑니다.
# 배포(Vercel)에서는 Settings → Environment Variables 에 같은 이름으로 넣습니다.
# .env 는 .gitignore 에 있어 커밋되지 않습니다.

# 풀이 문장을 쓰려면 필요합니다. console.anthropic.com 에서 발급.
# 없으면 사주 계산은 그대로 되고 풀이 문장만 나오지 않습니다.
ANTHROPIC_API_KEY=

# 공개 사이트라면 사실상 필수입니다. Vercel 대시보드의
# Storage → Upstash Redis 를 붙이면 아래 두 개가 자동으로 들어갑니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택. 비워 두면 각각 300 / 10 이 쓰입니다.
SAJU_DAILY_LIMIT=
SAJU_IP_HOURLY_LIMIT=
# 선택. IP 를 해시할 때 섞는 값.
SAJU_IP_SALT=

# 풀이 한 편에 쓸 수 있는 최대 시간(초). vercel.json 의 maxDuration 과 맞춰 두세요.
# 이 시간이 되기 4초 전에 스스로 멈추고 "여기서 멈췄습니다"라고 알립니다.
# 그냥 두면 플랫폼이 문장 한가운데서 연결을 끊어, 읽는 사람은 글이 원래 그렇게
# 끝난 줄 압니다. 안 넣으면 60초로 봅니다.
# Vercel 요금제별 상한: Hobby 60초 / Pro 300초.
# SAJU_MAX_SECONDS=60

# 풀이를 쓸 모델. 안 넣으면 claude-opus-5 로 돕니다.
# 값과 품질이 크게 다르니 직접 견주어 보고 정하세요(1회 대략값, 12절 풀이 기준).
#   claude-opus-5     $0.32   가장 좋은 글. 12절을 지키고 한국어 결이 자연스럽습니다
#   claude-sonnet-5   $0.13   절충안
#   claude-haiku-4-5  $0.07   가장 쌉니다. 대신 절 구성과 쉬운 말 규칙을 덜 지킵니다
# 모델마다 요청 모양이 달라(사고 과정·effort) 코드가 알아서 맞춰 보냅니다.
# SAJU_MODEL=claude-haiku-4-5
