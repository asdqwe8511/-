# 이 파일을 .env 로 복사해 값을 채우면 tools/dev-server.js 가 읽어 갑니다.
# 배포(Vercel)에서는 Settings → Environment Variables 에 같은 이름으로 넣습니다.
# .env 는 .gitignore 에 있어 커밋되지 않습니다.

# 풀이 문장을 쓰려면 필요합니다. console.anthropic.com 에서 발급.
# 없으면 사주 계산은 그대로 되고 풀이 문장만 나오지 않습니다.
ANTHROPIC_API_KEY=

# /youtube 대시보드에 필요합니다. Google Cloud Console 의 YouTube Data API v3 키.
YOUTUBE_API_KEY=

# 공개 사이트라면 사실상 필수입니다. Vercel 대시보드의
# Storage → Upstash Redis 를 붙이면 아래 두 개가 자동으로 들어갑니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 선택. 비워 두면 각각 300 / 10 이 쓰입니다.
SAJU_DAILY_LIMIT=
SAJU_IP_HOURLY_LIMIT=
# 선택. IP 를 해시할 때 섞는 값.
SAJU_IP_SALT=
